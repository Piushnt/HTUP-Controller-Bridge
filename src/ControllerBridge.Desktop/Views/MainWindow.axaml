<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ControllerBridge.Desktop.Views.MainWindow"
        Title="HTUP Controller Bridge"
        Width="1200"
        Height="800"
        Background="#0d1117"
        WindowStartupLocation="CenterScreen">
    <Grid RowDefinitions="Auto,*">
        <!-- Header -->
        <Border Grid.Row="0" Background="#010409" BorderBrush="#30363d" BorderThickness="0,0,0,1" Padding="20">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="HTUP Controller Bridge" FontSize="24" FontWeight="Bold" Foreground="#c9d1d9" />
                <TextBlock Text="v1.0" FontSize="12" Foreground="#8b949e" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" ColumnDefinitions="300,*" Padding="0">
            <!-- Sidebar -->
            <Border Grid.Column="0" Background="#010409" BorderBrush="#30363d" BorderThickness="0,0,1,0">
                <StackPanel Padding="0">
                    <Button Classes="SidebarButton" Content="Dashboard" />
                    <Button Classes="SidebarButton" Content="Controllers" />
                    <Button Classes="SidebarButton" Content="Network" />
                    <Button Classes="SidebarButton" Content="Settings" />
                </StackPanel>
            </Border>

            <!-- Main Panel -->
            <StackPanel Grid.Column="1" Padding="40">
                <TextBlock Text="Dashboard" FontSize="20" FontWeight="Bold" Foreground="#c9d1d9" Margin="0,0,0,20" />
                
                <!-- Status Grid -->
                <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" Gap="20" Margin="0,0,0,30">
                    <!-- Controller Status -->
                    <Border Grid.Column="0" Grid.Row="0" Background="#161b22" BorderBrush="#30363d" BorderThickness="1" CornerRadius="8" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Controller" Foreground="#8b949e" FontSize="12" Margin="0,0,0,5" />
                            <TextBlock Text="Not Connected" Foreground="#c9d1d9" FontSize="16" FontWeight="Bold" />
                            <TextBlock Text="Waiting for gamepad..." Foreground="#6e7681" FontSize="11" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Mobile Status -->
                    <Border Grid.Column="1" Grid.Row="0" Background="#161b22" BorderBrush="#30363d" BorderThickness="1" CornerRadius="8" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Mobile" Foreground="#8b949e" FontSize="12" Margin="0,0,0,5" />
                            <TextBlock Text="Disconnected" Foreground="#c9d1d9" FontSize="16" FontWeight="Bold" />
                            <TextBlock Text="0 clients connected" Foreground="#6e7681" FontSize="11" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Network Status -->
                    <Border Grid.Column="2" Grid.Row="0" Background="#161b22" BorderBrush="#30363d" BorderThickness="1" CornerRadius="8" Padding="20">
                        <StackPanel>
                            <TextBlock Text="Network" Foreground="#8b949e" FontSize="12" Margin="0,0,0,5" />
                            <TextBlock Text="Idle" Foreground="#c9d1d9" FontSize="16" FontWeight="Bold" />
                            <TextBlock Text="UDP Server on 5555" Foreground="#6e7681" FontSize="11" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Placeholder sections -->
                    <TextBlock Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="3" Text="Add more dashboard widgets here" Foreground="#6e7681" Margin="0,20,0,0" />
                </Grid>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
